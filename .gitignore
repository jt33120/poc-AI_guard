# Secrets — CLAUDE.md §4.7 (never commit secrets; trufflehog enforces in CI)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
dist/
build/

# Node / Next.js (M7)
node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/test-results/
frontend/playwright-report/
*.tsbuildinfo

# Vercel CLI local link state (deploy config lives in the Vercel project, not git)
.vercel/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# BMAD-METHOD personal install answers (per-teammate name/language); the
# shared team config is /_bmad/config.toml, which stays committed.
/_bmad/config.user.toml
