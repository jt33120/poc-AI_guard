# Secrets — CLAUDE.md §4.7 (never commit secrets; trufflehog enforces in CI)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
dist/
build/

# Node / Next.js (M7)
node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/test-results/
frontend/playwright-report/
*.tsbuildinfo

# Vercel CLI local link state (deploy config lives in the Vercel project, not git)
.vercel/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# BMAD-METHOD personal install answers (per-teammate name/language); the
# shared team config is /_bmad/config.toml, which stays committed.
/_bmad/config.user.toml

# Generated coverage artefacts (AD-30: the map is derived, never authored).
#
# `map.json` n'y est plus : le diagnostic de profil la sert à l'exécution, et un
# artefact publié qui n'existe pas dans l'image déployée n'est pas publié. Ce
# qu'`AD-30` garantit est désormais tenu par une garde de fraîcheur dans
# `gen_coverage.py --check`, qui échoue si la carte commitée diffère de ce que la
# génération produit — une garde vaut mieux qu'une absence de fichier.
/coverage/.scenarios.json
/perf/.counts.json
/coverage/COVERAGE-MAP.md

# Sauvegardes du plan de preuve (`make backup`) — jamais commitées.
backup/
/coverage/.sequences.json
/coverage/.demo_snapshot.json
