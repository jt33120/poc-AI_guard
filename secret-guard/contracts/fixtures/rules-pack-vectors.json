  "detection": [
    {
      "name": "prefix and exact length",
      "detector": {
        "id": "d",
        "label": "Détecteur",
        "category": "customer_data",
        "action": "block",
        "match": {
          "type": "pattern",
          "pattern": "CLI-[0-9]{8}"
        }
      },
      "text": "Dossier CLI-12345678 et CLI-87654321, pas CLI-1234.",
      "matches": ["CLI-12345678", "CLI-87654321"]
    },
    {
      "name": "case sensitive by default",
      "detector": {
        "id": "d",
        "label": "Détecteur",
        "category": "customer_data",
        "action": "block",
        "match": {
          "type": "pattern",
          "pattern": "CLI-[0-9]{8}"
        }
      },
      "text": "cli-12345678",
      "matches": []
    },
    {
      "name": "case insensitive, alternation, greedy bound",
      "detector": {
        "id": "d",
        "label": "Détecteur",
        "category": "customer_data",
        "action": "block",
        "match": {
          "type": "pattern",
          "pattern": "acme-(?:prod|staging)-db[0-9]{1,2}",
          "caseInsensitive": true
        }
      },
      "text": "connect to ACME-Prod-DB7 then acme-staging-db12x",
      "matches": ["ACME-Prod-DB7", "acme-staging-db12"]
    },
    {
      "name": "leftmost-first backtracking through alternation",
      "detector": {
        "id": "d",
        "label": "Détecteur",
        "category": "customer_data",
        "action": "block",
        "match": {
          "type": "pattern",
          "pattern": "PRJ-(?:A|AB)[0-9]{2}"
        }
      },
      "text": "ticket PRJ-AB12 ok",
      "matches": ["PRJ-AB12"]
    },
    {
      "name": "leftmost-first, not leftmost-longest",
      "detector": {
        "id": "d",
        "label": "Détecteur",
        "category": "customer_data",
        "action": "block",
        "match": {
          "type": "pattern",
          "pattern": "XYZ(?:a)?(?:ab)?"
        }
      },
      "text": "id XYZab end",
      "matches": ["XYZa"]
    },
    {
      "name": "non-overlapping successive matches",
      "detector": {
        "id": "d",
        "label": "Détecteur",
        "category": "customer_data",
        "action": "block",
        "match": {
          "type": "pattern",
          "pattern": "ABA"
        }
      },
      "text": "ABABA",
      "matches": ["ABA"]
    },
    {
      "name": "\\w is ASCII only",
      "detector": {
        "id": "d",
        "label": "Détecteur",
        "category": "customer_data",
        "action": "block",
        "match": {
          "type": "pattern",
          "pattern": "REF-\\w{4}"
        }
      },
      "text": "REF-été1 REF-ab_9",
      "matches": ["REF-ab_9"]
    },
    {
      "name": "\\s is ASCII only (no NBSP)",
      "detector": {
        "id": "d",
        "label": "Détecteur",
        "category": "customer_data",
        "action": "block",
        "match": {
          "type": "pattern",
          "pattern": "ACME\\s[0-9]{3}"
        }
      },
      "text": "ACME 123 ACME 456",
      "matches": ["ACME 456"]
    },
    {
      "name": "entropy threshold filters low-entropy matches",
      "detector": {
        "id": "d",
        "label": "Détecteur",
        "category": "customer_data",
        "action": "block",
        "match": {
          "type": "pattern",
          "pattern": "tok_[A-Za-z0-9]{16}",
          "minEntropyTenths": 30
        }
      },
      "text": "tok_aaaaaaaaaaaaaaaa tok_x7Kq9Lm2Pz4Rt8Vw",
      "matches": ["tok_x7Kq9Lm2Pz4Rt8Vw"]
    },
    {
      "name": "context keyword within window",
      "detector": {
        "id": "d",
        "label": "Détecteur",
        "category": "customer_data",
        "action": "block",
