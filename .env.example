# xSOM AI Guard — example environment.
#
# Quick start:  cp .env.example .env  &&  make dev
# As shipped, this file boots a working local dev server with zero edits: every
# key below is either a safe default or empty, and every empty key means "that
# optional feature is off" — never a crash. Features that touch data or money
# fail CLOSED when their key is missing (documented per key).
#
# Copy to `.env` (gitignored) and fill in. NEVER commit real secrets (CLAUDE.md §4.7).
# Every key here maps to a field of `Settings` in core/config.py; the reverse is
# enforced by tests/test_config.py, so a new setting can never ship undocumented.

# --- Runtime --------------------------------------------------------------
# dev | staging | prod. In prod, /docs & /redoc are disabled (CLAUDE.md §4.8).
# Default: dev.
ENV=dev
# Display name of this instance (docs title, exports). Default: "xSOM AI Guard".
APP_NAME=xSOM AI Guard
# Root log level for the JSON logger. Default: INFO.
LOG_LEVEL=INFO

# --- Control API hardening ------------------------------------------------
# Browser origins allowed to call the control API. Comma-separated explicit
# allowlist ('https://a.example,https://b.example'); a JSON list is also
# accepted. Wildcard "*" is REFUSED at boot (CLAUDE.md §4.8).
# Empty = no browser origin allowed; the API still serves machine clients
# (gateway, agents, curl), only the frontend is locked out. The value below is
# the local Next.js dev server, which is what `make dev` starts.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Supabase auth (M1) ---------------------------------------------------
# Project URL of YOUR Supabase project (Project settings → API), e.g.
# https://<your-ref>.supabase.co. Empty = no JWKS endpoint can be derived, so
# every authenticated endpoint rejects its caller (fail-closed). /health still
# answers, which is enough to run the test suite and the local demo.
SUPABASE_URL=
# Explicit JWKS endpoint. Leave empty to derive it as
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json — only set it if your project
# publishes its keys elsewhere.
SUPABASE_JWKS_URL=
# Expected `aud` claim of the Supabase access token. Default: authenticated.
SUPABASE_JWT_AUDIENCE=authenticated
# Expected `iss` claim. Empty = issuer not checked beyond the JWKS signature;
# set it to {SUPABASE_URL}/auth/v1 in prod.
SUPABASE_JWT_ISSUER=
# Supabase service-role key (Project settings → API → service_role).
# BACKEND ONLY — never expose it to the frontend, never commit it, never put it
# in a NEXT_PUBLIC_* variable (CLAUDE.md §4.6). It bypasses RLS entirely.
# It unlocks self-serve signup: POST /v1/signup provisions the tenant, the admin
# user and its role claim in one call. Empty = signup answers 503 forever and a
# tenant can only be created by hand — see docs/DEPLOY.md.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (M1) --------------------------------------------------------
# psycopg DSN for the backend (service_role / RLS-bypassing connection).
# Local example: postgresql://postgres:postgres@localhost:5432/postgres
# Supabase (deployed): use the Session pooler (IPv4, :5432), NOT the IPv6-only
# direct host — see docs/DEPLOY.md.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Empty = every endpoint that reads or writes data returns an error, and the MCP
# gateway refuses to start (it cannot authenticate its tenant token).
# Under `docker compose` (docker-compose.yml) leave this EMPTY to use the bundled
# database; it defaults to the `db` service at host `db`. Do not point it at
# `localhost` there — inside a container that resolves to the container itself,
# not to your machine. Use `host.docker.internal` or the real hostname instead.
DATABASE_URL=

# --- MCP gateway (agent side) ---------------------------------------------
# Read from the environment of the *agent process* that launches the gateway,
# not by the control API. Issue one from the UI (Settings → Gateway tokens) or
# POST /v1/gateway-tokens. Empty/invalid = the gateway refuses to start
# (fail-closed, CLAUDE.md §4.4). Treat it like a password.
XSOM_TENANT_TOKEN=

# --- Deployment-time variables (NOT Settings fields) ----------------------
# Read by the CLI, by docker-compose.yml or by the Next.js build — never by
# core/config.py. They live here so an operator finds every knob in one file;
# tests/test_config.py pins the list so a new one cannot ship undocumented.

# ONE-SHOT — KEEP IT COMMENTED OUT. Initial admin password for
# `python -m cli bootstrap --email <login>`. It is deliberately not a
# command-line flag: argv is visible to every process via `ps` and is kept in
# shell history. Export it for that single command, or leave this commented and
# the CLI prompts on the TTY. It is never stored, logged or echoed back.
# XSOM_ADMIN_PASSWORD=

# Base URL of the control API, baked into the console at BUILD time by Next.js
# (`NEXT_PUBLIC_*` is substituted by `next build`, so setting it at runtime does
# nothing). It is what the onboarding wizard writes into the snippets it
# generates. Empty = the console falls back to its own origin, which is correct
# only when the API and the console are served from the same host.
NEXT_PUBLIC_XSOM_API_URL=

# Host ports published by docker-compose.yml, both bound to 127.0.0.1 only.
# A port collision is the most common first-run failure — override it here
# rather than editing the compose file. Defaults: 8000 and 5432.
XSOM_API_PORT=8000
XSOM_DB_PORT=5432

# --- Rate limits (slowapi syntax: "<count>/<period>") ---------------------
# Guard rails on the costly or abusable endpoints (CLAUDE.md §4.9). All have
# working defaults; only raise them deliberately.
# POST /v1/signup — unauthenticated, provisions a tenant. Default: 10/hour.
SIGNUP_RATE_LIMIT=10/hour
# POST /v1/authorize — machine-to-machine, one call per agent action.
# Default: 120/minute.
AUTHORIZE_RATE_LIMIT=120/minute
# Compliance/audit export endpoints (large reads + LLM narrative).
# Default: 30/minute.
EXPORT_RATE_LIMIT=30/minute
# LLM provider proxy (/v1/llm/...), on the agent's hot path. Default: 240/minute.
LLM_PROXY_RATE_LIMIT=240/minute
# Natural-language policy assistant (LLM-backed). Default: 20/minute.
POLICY_DRAFT_RATE_LIMIT=20/minute
# POST /v1/triage — diagnostic public de profil (QO-7). Non authentifié, et en
# écriture : il enregistre une capture de prospect. Default: 20/hour.
TRIAGE_RATE_LIMIT=20/hour

# --- LLM judge (M6, optional) — LiteLLM -> Mistral ------------------------
# Empty MISTRAL_API_KEY disables the judge (fail-closed): ambiguous tools are
# treated as irreversible, so they go to human approval instead of being
# auto-allowed. The deterministic policy engine does not need it.
MISTRAL_API_KEY=
# Model id passed to LiteLLM. Default: mistral/mistral-small-latest.
MISTRAL_MODEL=mistral/mistral-small-latest
# --- Observation windows (G-25, AD-27) ------------------------------------
# Enforcement is the default and is NOT a request-level choice: the agent being
# controlled does not decide whether it is controlled. An admin may open a bounded
# observation window on one agent (POST /v1/monitor-windows) to see what
# enforcement would do before turning it loose on a fleet. This is the ceiling on
# such a window, in hours — a window without a short deadline is not an
# observation, it is a bypass. Irreversible actions and external sends are never
# covered by a window, whatever this is set to. Default: 24.
MONITOR_MAX_HOURS=24

# Hard ceiling on judge calls per process, so an agent loop cannot burn the
# budget. Once exhausted, ambiguous tools fall back to the same fail-closed
# treatment as an unconfigured judge (held, not auto-allowed). Default: 200.
JUDGE_MAX_CALLS=200

# --- Compliance (EU AI Act, M9) -----------------------------------------
# Retention floor for operational-data purges (days). EU AI Act art. 12 sets
# a 6-month (183-day) minimum for high-risk logs; purges below this are refused
# and /v1/compliance/status reports "not ready" if it is set lower.
# Default: 183.
AUDIT_RETENTION_DAYS=183

# --- LLM provider proxy (zero-code monitoring + cost) --------------------
# Upstream bases the proxy forwards to (agents point their base_url at xSOM).
# Defaults are the public provider endpoints; override only for a private
# gateway or a regional endpoint.
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
MISTRAL_BASE_URL=https://api.mistral.ai
OPENROUTER_BASE_URL=https://openrouter.ai/api

# --- Egress data-loss guard (DLP) — scan outbound prompts ----------------
# OFF by default (zero overhead). When on: fixed-form secrets are blocked,
# structured PII is flagged (observe, don't break the agent), and the
# high-entropy scan is opt-in. Never logs the value (kind + hash only, §4.10).
DLP_ENABLED=false
# Per-class action: block | redact | flag | off. Defaults below.
DLP_SECRET_ACTION=block
DLP_PII_ACTION=flag
DLP_ENTROPY_ACTION=off

# --- Secrets: provider credentials (envelope encryption) -----------------
# Backend wrapping the per-tenant data keys: "aws" (prod) or "local" (dev only).
# Empty = storing or decrypting a provider credential fails closed; the rest of
# the product works. "local" in prod is refused.
SECRETS_KMS_PROVIDER=
# KMS key ARN/id, required when SECRETS_KMS_PROVIDER=aws.
AWS_KMS_KEY_ID=
# Dev/test ONLY — base64 of 32 random bytes (e.g. `openssl rand -base64 32`).
# Required when SECRETS_KMS_PROVIDER=local.
SECRETS_LOCAL_KEK=

# --- HITL approval notifications (M4, optional) ---------------------------
# Leave SMTP_HOST empty to disable email notifications: approvals still gate the
# action, reviewers just have to watch the approval queue in the UI.
SMTP_HOST=
# SMTP port. Default: 587 (submission + STARTTLS).
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Envelope sender, e.g. xsom@your-domain.example.
SMTP_FROM=
# Use STARTTLS. Default: true. Only set false for a local mail catcher.
SMTP_USE_TLS=true
# Mailbox that receives "an action is waiting for approval" notices.
APPROVAL_NOTIFY_TO=

# --- Observability (optional) — CLAUDE.md §3 -----------------------------
# Leave empty to disable Sentry. Never required to boot.
SENTRY_DSN=
# Fraction of transactions traced, 0.0–1.0. Default: 0.0 (errors only).
SENTRY_TRACES_SAMPLE_RATE=0.0
