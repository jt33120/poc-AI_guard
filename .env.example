# xSOM AI Guard — example environment.
# Copy to `.env` (gitignored) and fill in. NEVER commit real secrets (CLAUDE.md §4.7).
# Fields here are loaded and validated by core/config.py (pydantic-settings).
# More fields are added milestone by milestone (auth → M1, judge → M6, ...).

# --- Runtime --------------------------------------------------------------
# dev | staging | prod. In prod, /docs & /redoc are disabled (CLAUDE.md §4.8).
ENV=dev
APP_NAME=xSOM AI Guard
LOG_LEVEL=INFO

# --- Control API hardening ------------------------------------------------
# Comma-separated explicit allowlist. Wildcard "*" is forbidden (CLAUDE.md §4.8).
# Leave empty in prod until the frontend origin is known.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Supabase auth (M1) ---------------------------------------------------
# Project URL; the JWKS endpoint is derived as
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json unless SUPABASE_JWKS_URL is set.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=

# --- Database (M1) --------------------------------------------------------
# psycopg DSN for the backend (service_role / RLS-bypassing connection).
# Local example: postgresql://postgres:postgres@localhost:5432/postgres
# Supabase (deployed): use the Session pooler (IPv4, :5432), NOT the IPv6-only
# direct host — see docs/DEPLOY.md.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# --- LLM judge (M6, optional) — LiteLLM -> Mistral ------------------------
# Empty MISTRAL_API_KEY disables the judge (fail-closed): ambiguous tools are
# treated as irreversible. Bounded by JUDGE_MAX_CALLS; export endpoint rate-limited.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral/mistral-small-latest
JUDGE_MAX_CALLS=200
EXPORT_RATE_LIMIT=30/minute

# --- HITL approval notifications (M4, optional) ---------------------------
# Leave SMTP_HOST empty to disable email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
APPROVAL_NOTIFY_TO=

# --- Observability (optional) — CLAUDE.md §3 -----------------------------
# Leave empty to disable Sentry. Never required to boot.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
